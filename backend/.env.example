# wakeel.connect backend — environment template.
# Copy to .env and fill in. NEVER commit .env.

NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://wakeel:wakeel_dev_only@localhost:5432/wakeelconnect?schema=public"

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=REPLACE_WITH_48_BYTE_RANDOM_SECRET
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7

FRONTEND_URL=http://localhost:3100
COOKIE_SECURE=false

OTP_PEPPER=REPLACE_WITH_RANDOM_16_PLUS_CHARS
OTP_TTL_MIN=5
OTP_MAX_ATTEMPTS=5

# log = print OTP to server console (dev). twilio = real SMS.
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
