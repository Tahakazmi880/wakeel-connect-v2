# Production environment template for the wakeel.connect API.
# Copy to .env and fill in — NEVER commit real values to git.
# Generate secrets with: openssl rand -hex 32

NODE_ENV=production
PORT=4000

# Supabase PostgreSQL — use the pooler URL (port 6543) for Prisma.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Auth secrets (min lengths enforced at boot: JWT 32 chars, pepper 16).
JWT_SECRET=<openssl rand -hex 32>
OTP_PEPPER=<openssl rand -hex 16>

# Must be the exact public frontend origin (CORS + cookie domain).
FRONTEND_URL=https://your-frontend.vercel.app
COOKIE_SECURE=true

# OTP delivery: "log" writes codes to server logs (dev).
# Real SMS needs a provider — see SMS_PROVIDER options in src/lib/env.ts.
SMS_PROVIDER=log

# Supabase Storage for case documents (Render disk is ephemeral).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=<service_role key — dashboard only, never in git>
SUPABASE_BUCKET=booking-docs
