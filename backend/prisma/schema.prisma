// ============================================================
// wakeel.connect — database schema (v2, fresh rebuild)
// PostgreSQL + Prisma 6.
//
// Conventions:
//  - Money: *Paisa Int (1 PKR = 100 paisa). Snapshot amounts on
//    booking/payment rows; never store floats.
//  - Timestamps: UTC in DB. Display in Asia/Karachi in app code.
//  - PII: CNIC is stored as cnicHash ONLY — never plaintext.
//    Verification documents are private; referenced by storageKey
//    and served through signed URLs.
//  - History: financial/legal rows are never cascade-deleted
//    (onDelete: NoAction). Only pure join tables cascade.
//  - DB-level guards that Prisma cannot express live in
//    prisma/migrations/*_init/migration.sql (appended after
//    `prisma migrate diff`): booking overlap EXCLUDE constraint,
//    review rating CHECK, pg_trgm index, dayOfWeek CHECK.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Enums ----------------

enum Role {
  CLIENT
  LAWYER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BookingMode {
  ONLINE_VIDEO
  IN_CHAMBER
  PHONE
}

enum Gender {
  MALE
  FEMALE
}

enum PaymentStatus {
  PENDING
  HELD
  RELEASED
  REFUNDED
  FAILED
}

enum DocType {
  CNIC_FRONT
  CNIC_BACK
  BAR_COUNCIL_CERT
  DEGREE
  PROFILE_PHOTO
  OTHER
}

enum DocStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

// ---------------- Users & auth ----------------

model User {
  id              String      @id @default(cuid())
  phone           String      @unique // +92... E.164 — primary identifier (OTP auth)
  phoneVerifiedAt DateTime?
  email           String?     @unique // optional; always lowercase (service rule)
  passwordHash    String? // optional fallback; OTP is the primary flow
  fullName        String
  role            Role        @default(CLIENT)
  status          UserStatus  @default(ACTIVE)
  avatarUrl       String?
  cityId          String?
  city            City?       @relation(fields: [cityId], references: [id])
  lastLoginAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  lawyerProfile Lawyer?
  notifications Notification[]
  auditLogs     AuditLog[]     @relation("AuditActor")
  bookings      Booking[]      @relation("ClientBookings")
  reviews       Review[]       @relation("ClientReviews")
  reviewedDocs  VerificationDocument[] @relation("DocReviewer")
  decisions     VerificationDecision[] @relation("DecisionAdmin")
  refreshSessions RefreshSession[]
  forumQuestions  ForumQuestion[]  @relation("QuestionAuthor")
  forumAnswers    ForumAnswer[]    @relation("AnswerAuthor")
  uploadedBookingDocs BookingDocument[] @relation("DocUploader")
  favorites       Favorite[]
  notificationPreference NotificationPreference?

  @@index([role, status])
}

// ---------------- OTP auth & sessions ----------------

model OtpCode {
  id          String    @id @default(cuid())
  phone       String // E.164 — not unique; history of attempts is kept
  codeHash    String // SHA-256(code + server pepper); never plaintext
  purpose     String    @default("login") // login
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
}

model RefreshSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // SHA-256 of the opaque token; the raw token only lives in the cookie
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, revokedAt])
}

// ---------------- Reference data (seed) ----------------

model City {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameEn   String
  nameUr   String?
  province String
  isActive Boolean @default(true)

  users    User[]
  lawyers  Lawyer[]
  chambers Chamber[]
  lawyerCities LawyerCity[]

  @@index([isActive])
}

model PracticeArea {
  id          String  @id @default(cuid())
  slug        String  @unique
  nameEn      String
  nameUr      String?
  description String? @db.Text
  icon        String? // icon key for the frontend (e.g. "family", "briefcase"); null = generic
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parentId String?
  parent   PracticeArea?  @relation("AreaHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children PracticeArea[] @relation("AreaHierarchy")

  lawyers LawyerPracticeArea[]
  forumQuestions ForumQuestion[]

  @@index([isActive, sortOrder])
  @@index([parentId])
}

model ForumQuestion {
  id         String        @id @default(cuid())
  authorId   String?
  author     User?         @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String // display-name snapshot (guests allowed)
  areaId     String?
  area       PracticeArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)
  title      String
  body       String        @db.Text
  isSeed     Boolean       @default(false)
  isLocked   Boolean       @default(false) // seed rows: answers open after launch
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  answers ForumAnswer[]

  @@index([areaId, createdAt])
}

model ForumAnswer {
  id         String        @id @default(cuid())
  questionId String
  question   ForumQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?         @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  body       String        @db.Text
  isSeed     Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([questionId, createdAt])
}

model Language {
  code   String @id // ur, en, pa, sd, ps
  nameEn String
  nameUr String?

  lawyers LawyerLanguage[]
}

// ---------------- Lawyers & verification ----------------

model Lawyer {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: NoAction)
  slug                 String             @unique
  displayName          String
  headline             String?
  bio                  String?            @db.Text
  bioUrdu              String?            @db.Text
  gender               Gender?
  photoUrl             String? // public path e.g. /lawyers/<slug>.jpg — served by the API; null = initials avatar
  cityId               String
  city                 City               @relation(fields: [cityId], references: [id])
  yearsExperience      Int                @default(0)
  consultationFeePaisa Int                @default(0)
  offersOnline         Boolean            @default(false) // online consultation offered
  onlineFeePaisa       Int                @default(0) // online consultation fee; 0 = on request
  memberships          String[]           @default([]) // professional memberships / bar associations
  courts               String[]           @default([]) // courts of appearance
  barCouncil           String? // e.g. "Punjab Bar Council"
  barCouncilNo         String? // enrolment / license number
  enrolmentYear        Int?
  cnicHash             String? // salted hash ONLY — never plaintext CNIC
  uploadTokenHash      String? // SHA-256 of the one-time document-upload token issued at application time
  uploadTokenExpiresAt DateTime? // upload token validity (24h); null = no active token
  verificationStatus   VerificationStatus @default(PENDING)
  verifiedAt           DateTime?
  isListed             Boolean            @default(false) // public only after APPROVED
  isSeedData           Boolean            @default(false) // demo rows; never present as real lawyers
  ratingAvg            Float              @default(0)
  ratingCount          Int                @default(0)
  totalConsultations   Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  practiceAreas LawyerPracticeArea[]
  languages     LawyerLanguage[]
  cities        LawyerCity[]
  chambers      Chamber[]
  education     Education[]
  weeklyAvail   WeeklyAvailability[]
  dateOverrides DateOverride[]
  bookings      Booking[]              @relation("LawyerBookings")
  reviews       Review[]               @relation("LawyerReviews")
  documents     VerificationDocument[]
  decisions     VerificationDecision[] @relation("DecisionLawyer")
  favorites     Favorite[]

  @@index([cityId, isListed, verificationStatus])
  @@index([isSeedData])
}

model LawyerPracticeArea {
  lawyerId       String
  lawyer         Lawyer       @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  practiceAreaId String
  practiceArea   PracticeArea @relation(fields: [practiceAreaId], references: [id], onDelete: Cascade)
  isPrimary      Boolean      @default(false)

  @@id([lawyerId, practiceAreaId])
  @@index([practiceAreaId])
}

model LawyerLanguage {
  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  langCode String
  language Language @relation(fields: [langCode], references: [code], onDelete: Cascade)

  @@id([lawyerId, langCode])
}

model LawyerCity {
  lawyerId String
  lawyer   Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  cityId   String
  city     City   @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([lawyerId, cityId])
  @@index([cityId])
}

model Education {
  id          String @id @default(cuid())
  lawyerId    String
  lawyer      Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  degree      String
  institution String
  year        Int?

  @@index([lawyerId])
}

model Chamber {
  id        String  @id @default(cuid())
  lawyerId  String
  lawyer    Lawyer  @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  name      String
  address   String
  cityId    String
  city      City    @relation(fields: [cityId], references: [id])
  phone     String?
  isPrimary Boolean @default(false)
  createdAt DateTime @default(now())

  bookings Booking[]

  @@index([lawyerId])
}

model WeeklyAvailability {
  id        String @id @default(cuid())
  lawyerId  String
  lawyer    Lawyer @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0 = Sunday … 6 = Saturday (CHECK 0–6 in migration SQL)
  startTime Int // minutes since midnight (e.g. 540 = 09:00)
  endTime   Int // minutes since midnight (e.g. 1020 = 17:00)
  isActive  Boolean @default(true)

  @@unique([lawyerId, dayOfWeek, startTime])
  @@index([lawyerId, dayOfWeek])
}

model DateOverride {
  id          String   @id @default(cuid())
  lawyerId    String
  lawyer      Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  isAvailable Boolean  @default(true)
  startTime   Int? // minutes since midnight; null = closed / default rules
  endTime     Int?
  reason      String?

  @@unique([lawyerId, date])
}

model VerificationDocument {
  id           String    @id @default(cuid())
  lawyerId     String
  lawyer       Lawyer    @relation(fields: [lawyerId], references: [id], onDelete: NoAction)
  type         DocType
  storageKey   String // private object-store key; signed URLs only
  mimeType     String
  sizeBytes    Int
  status       DocStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?     @relation("DocReviewer", fields: [reviewedById], references: [id], onDelete: NoAction)
  reviewedAt   DateTime?
  reviewNote   String?
  uploadedAt   DateTime  @default(now())

  @@index([lawyerId, status])
}

model VerificationDecision {
  id         String             @id @default(cuid())
  lawyerId   String
  lawyer     Lawyer             @relation("DecisionLawyer", fields: [lawyerId], references: [id], onDelete: NoAction)
  adminId    String
  admin      User               @relation("DecisionAdmin", fields: [adminId], references: [id], onDelete: NoAction)
  fromStatus VerificationStatus
  toStatus   VerificationStatus
  note       String?            @db.Text
  createdAt  DateTime           @default(now())

  @@index([lawyerId])
}

// ---------------- Bookings & payments ----------------

model Booking {
  id           String        @id @default(cuid())
  clientId     String
  client       User          @relation("ClientBookings", fields: [clientId], references: [id], onDelete: NoAction)
  lawyerId     String
  lawyer       Lawyer        @relation("LawyerBookings", fields: [lawyerId], references: [id], onDelete: NoAction)
  chamberId    String?
  chamber      Chamber?      @relation(fields: [chamberId], references: [id], onDelete: NoAction)
  startAt      DateTime      @db.Timestamptz
  endAt        DateTime      @db.Timestamptz
  status       BookingStatus @default(PENDING)
  mode         BookingMode   @default(IN_CHAMBER)
  feePaisa     Int // snapshot of the fee at booking time
  clientPhone  String // contact snapshot; shown to lawyer only after confirmation
  clientNote   String?       @db.Text
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  payment Payment?
  review  Review?
  documents BookingDocument[]

  @@index([lawyerId, startAt])
  @@index([clientId, status])
}

model BookingDocument {
  id           String   @id @default(cuid())
  bookingId    String
  booking      Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?    @relation("DocUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  fileName     String // original name (sanitized for display)
  storageKey   String // private on-disk key; served only through the download route
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([bookingId])
}

model Payment {
  id           String        @id @default(cuid())
  bookingId    String?       @unique
  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: NoAction)
  amountPaisa  Int
  currency     String        @default("PKR")
  provider     String // JAZZCASH | EASYPAISA | BANK (real credentials required)
  status       PaymentStatus @default(PENDING)
  providerRef  String?
  attempts     Json? // every attempt preserved across retries
  failureReason String?
  paidAt       DateTime?
  releasedAt   DateTime?
  refundedAt   DateTime?
  createdAt    DateTime      @default(now())

  @@index([status])
}

// ---------------- Reviews (completed bookings only) ----------------

model Review {
  id        String   @id @default(cuid())
  bookingId String   @unique // one review per booking (service rule: only COMPLETED)
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction)
  lawyerId  String
  lawyer    Lawyer   @relation("LawyerReviews", fields: [lawyerId], references: [id], onDelete: NoAction)
  clientId  String
  client    User     @relation("ClientReviews", fields: [clientId], references: [id], onDelete: NoAction)
  rating    Int // 1–5 enforced by CHECK constraint in migration SQL
  comment   String?  @db.Text
  verified  Boolean  @default(true) // verified client of a completed booking
  hidden    Boolean  @default(false) // admin moderation: hidden from public
  createdAt DateTime @default(now())

  @@index([lawyerId, createdAt])
}

// ---------------- Notifications & audit ----------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // booking.confirmed, verification.approved, …
  title     String
  body      String?
  link      String?
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: NoAction)
  action     String // verification.approved, booking.cancelled, …
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ---------------- Leads ----------------

// Callback-request leads ("Request a callback" form for high-value matters).
model Lead {
  id        String     @id @default(cuid())
  fullName  String
  phone     String // E.164 normalized
  citySlug  String
  matter    String // practice-area slug or free text
  notes     String?    @db.Text
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdAt])
  @@index([status])
}

// ---------------- Saved lawyers ----------------

// Client-saved (favorite) lawyers — shortlist on cards/profiles.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lawyerId  String
  lawyer    Lawyer   @relation(fields: [lawyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, lawyerId])
  @@index([userId])
}

// ---------------- Content management ----------------

// Key-value site settings (hero copy, contact details, announcements).
// Seeded with generic values only; real contact data added when confirmed.
model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// Frequently asked questions — bilingual, grouped by category.
// Only claims about existing features; never invented promises.
model Faq {
  id         String   @id @default(cuid())
  question   String
  questionUr String?
  answer     String   @db.Text
  answerUr   String?  @db.Text
  category   String? // booking, documents, qna, general
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Corporate / institutional clients whose logos appear on the homepage.
// Only confirmed real clients are seeded — never invented.
model Partner {
  id         String   @id @default(cuid())
  name       String
  logoUrl    String? // e.g. /partners/js-bank.png
  websiteUrl String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([isActive, sortOrder])
}

// Homepage promotional banners / campaign slots.
model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?  @db.Text
  imageUrl  String?
  ctaText   String?
  ctaUrl    String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([isActive, sortOrder])
}

// Per-user notification preferences (opt-in/out for each channel).
model NotificationPreference {
  userId          String  @id
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingUpdates  Boolean @default(true)
  qaUpdates       Boolean @default(true)
  marketingOptIn  Boolean @default(false)
  updatedAt       DateTime @updatedAt
}
